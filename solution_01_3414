import bisect
import functools
from dataclasses import dataclass


@dataclass(frozen=True)
class State:
  weight: int
  selected: tuple[int, ...]

  # Custom comparison logic to prioritize higher weight,
  # and break ties with lexicographically smaller sorted indices.
  def __lt__(self, other):
    if self.weight != other.weight:
      return self.weight < other.weight
    # Lexicographically smaller tuple is preferred, so it's "better"
    return self.selected > other.selected


   


    

